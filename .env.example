# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional but recommended (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your-fred-api-key-here

# Database (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///./data/db/finance.db

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173

# Cache TTL in seconds (default 24h)
CACHE_TTL_SECONDS=86400

# LLM settings
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=8192

# Analysis settings
MAX_CONCURRENT_AGENTS=3
ANALYSIS_TIMEOUT_SECONDS=300
